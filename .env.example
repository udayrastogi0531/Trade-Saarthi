# Application — governance: docs/FINAL_STABLE_RELEASE_CHARTER.md (architecture frozen v4.0.2)
APP_NAME=AI Trading Assistant
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql+asyncpg://trading:trading_secret@postgres:5432/trading_db

# Redis
REDIS_URL=redis://redis:6379/0

# Risk defaults (override per account)
MAX_DAILY_LOSS_PCT=2.0
MAX_DRAWDOWN_PCT=10.0
MAX_TRADES_PER_DAY=5
MAX_POSITION_SIZE_PCT=5.0
MIN_RISK_REWARD=2.0
DEFAULT_ACCOUNT_CAPITAL=100000

# AI (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=groq
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# Brokers
BROKER_MODE=paper
KITE_API_KEY=
KITE_API_SECRET=
# KITE_ACCESS_TOKEN is issued after login via /api/v1/broker/kite/callback
KITE_ACCESS_TOKEN=

# Market data
MARKET_DATA_PROVIDER=mock
NSE_ENABLED=true

# Execution
EXECUTION_ENABLED=false
PAPER_TRADING=true

# Monitoring
PROMETHEUS_ENABLED=true

# Scanner v2
SCANNER_ENABLED=true
SCANNER_INTERVAL_MINUTES=3
WATCHLIST_SYMBOLS=RELIANCE,TCS,INFY,HDFCBANK,NIFTY
SCANNER_MIN_CONFIDENCE=70
MIN_SIGNAL_QUALITY_SCORE=65
MIN_MTF_ALIGNMENT_SCORE=0.6
SIGNAL_CONFIDENCE_THRESHOLD=72

# Advanced risk
ATR_STOP_MULTIPLIER=1.5
MAX_PORTFOLIO_EXPOSURE_PCT=30
MAX_SECTOR_EXPOSURE_PCT=15
CONSECUTIVE_LOSS_REDUCTION=3
DAILY_RISK_BUDGET_PCT=2

# Celery
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# AI Copilot (v2.1)
COPILOT_ENABLED=true
COPILOT_DEFAULT_LANGUAGE=hinglish
STT_PROVIDER=groq
GROQ_WHISPER_MODEL=whisper-large-v3
TTS_PROVIDER=gtts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DEEPGRAM_API_KEY=
VOICE_ALERTS_ENABLED=true

# v2.2 Institutional Intelligence
MIN_STRUCTURE_CONFIDENCE=55
STRUCTURE_BLOCK_FAKE_BREAKOUT=true
LEARNING_ENABLED=true
ADAPTIVE_CONFIDENCE_ENABLED=true
BRIEFINGS_ENABLED=true
EXECUTION_MANUAL_CONFIRM=true
EXECUTION_COOLDOWN_MINUTES=15
VOLATILITY_SHUTDOWN_ATR_PCT=8

# v4.0 Quant Validation
CONSERVATIVE_MODE=true
MIN_SIGNAL_QUALITY_SCORE=72
SIGNAL_CONFIDENCE_THRESHOLD=78
MIN_LIQUIDITY_VOLUME_RATIO=0.65
MAX_FAKE_BREAKOUT_RISK=0.55
DATA_QUALITY_ENABLED=true
BLOCK_SIGNALS_ON_BAD_DATA=true
CAPITAL_SAFETY_ENABLED=true
DEFAULT_DEPLOYMENT_STAGE=sandbox
TINY_LIVE_MAX_CAPITAL=10000
MONTE_CARLO_SIMULATIONS=2000
API_AUTH_ENABLED=false
API_KEY=
AUDIT_LOG_ENABLED=true
AI_REASONING_CACHE_TTL_SECONDS=180
ENFORCE_NSE_MARKET_HOURS=false
